# Copy to .env and edit. start.sh loads .env automatically (export-style KEY=VALUE).

# Web UI (default 5001 — avoids macOS AirPlay on 5000)
# PORT=5001

# Optional: EasyOCR for every file processed by ingestion_handler (not the upload checkbox)
# OCR_HANDWRITING_ASSIST=1

# Optional: sharper PDF rendering for OCR (handwriting / faint text)
# OCR_PDF_DPI=400

# Optional second process: set to 1 so ./start.sh also runs the folder watcher
# START_INGESTION=1

# LLM extraction runs after every OCR by default (needs Ollama + a model).
# SKIP_LLM=1
# LLM_MODEL=llama3
# LLM_OCR_CHARS=12000
# OLLAMA_URL=http://localhost:11434/api/chat

# start.sh: try to run `ollama serve` if API is down (set SKIP_OLLAMA=1 to never)
# SKIP_OLLAMA=1
# OLLAMA_PORT=11434
