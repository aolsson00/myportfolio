# Copy to .env and edit. start.sh loads .env automatically (export-style KEY=VALUE).

# Web UI (default 5001 — avoids macOS AirPlay on 5000)
# PORT=5001

# Optional: EasyOCR for every file processed by ingestion_handler (not the upload checkbox)
# OCR_HANDWRITING_ASSIST=1

# Optional: sharper PDF rendering for OCR (handwriting / faint text)
# OCR_PDF_DPI=400

# Normalize/clean OCR text before LLM, regex demographics, and FHIR (default: on)
# SKIP_OCR_TEXT_CLEAN=1

# spaCy local NLP (en_core_web_sm) — sentence + NER assists extraction; optional LLM summary
# SKIP_SPACY=1
# NLP_LLM_SUMMARY=0

# Gold FHIR Bundle JSON for few-shot LLM alignment (see examples/gold_fhir_bundle.json)
# FHIR_GOLD_EXAMPLE_PATH=examples/gold_fhir_bundle.json
# SKIP_FHIR_GOLD_PROMPT=1
# FHIR_GOLD_MAX_CHARS=12000

# Optional second process: set to 1 so ./start.sh also runs the folder watcher
# START_INGESTION=1

# After OCR + LLM, rename PDF and related files to First_Last_MM-DD-YYYY when demographics parse
# SKIP_PATIENT_FILENAME_RENAME=1

# LLM extraction runs after every OCR by default (needs Ollama + a model).
# SKIP_LLM=1
# LLM_MODEL=llama3
# Optional jargon / section hints appended to the LLM prompt (resources/clinical_context_for_llm.txt)
# SKIP_LLM_CLINICAL_CONTEXT=1
# LLM_CLINICAL_CONTEXT_PATH=resources/clinical_context_for_llm.txt
# LLM_CLINICAL_CONTEXT_CHARS=16000
# Max characters of OCR passed into the LLM (raise for long discharge summaries; needs model context)
# LLM_OCR_CHARS=32768
# head_tail = first ~half + last ~half when over budget (default). head = start only.
# LLM_OCR_EXCERPT_MODE=head_tail
# OLLAMA_URL=http://localhost:11434/api/chat

# start.sh: try to run `ollama serve` if API is down (set SKIP_OLLAMA=1 to never)
# SKIP_OLLAMA=1
# OLLAMA_PORT=11434
