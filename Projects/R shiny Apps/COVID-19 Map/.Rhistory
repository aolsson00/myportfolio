# Step 1: Get the top 20 most common Crm Cd
top_20_crime_codes <- weapon_df %>%
count(`Crm Cd`, sort = TRUE) %>%
slice_head(n = 20) %>%
pull(`Crm Cd`)
# Step 2: Filter weapon_df for only those top crime codes
filtered_weapon_df <- weapon_df %>%
filter(`Crm Cd` %in% top_20_crime_codes)
# Step 3: Aggregate frequency by hour and Crm Cd
crm_hourly_freq <- filtered_weapon_df %>%
group_by(hour, `Crm Cd`) %>%
summarise(count = n(), .groups = "drop")
# Step 4: Plot scatter with lines
ggplot(crm_hourly_freq, aes(x = hour, y = count, color = as.factor(`Crm Cd`))) +
geom_point(size = 2, alpha = 0.7) +
geom_line(linewidth = 1, alpha = 0.8) +
theme_minimal() +
labs(
title = "Hourly Frequency of Top 20 Crime Codes (Weapon-Related)",
x = "Hour of Day",
y = "Number of Crimes",
color = "Crime Code"
)
View(hourly_tests)
View(filtered_top_df)
ggplot(weapon_df, aes(x = hour)) +
geom_histogram(binwidth = 1, fill = "darkorchid", color = "black") +
theme_minimal() +
labs(
title = "Distribution of Crimes by Minute",
x = "Minute of the Hour",
y = "Number of Crimes"
)
