) %>%
mutate(
`TIME OCC` = str_pad(as.character(`TIME OCC`), width = 4, pad = "0"),
hour = as.integer(substr(`TIME OCC`, 1, 2)),
minute = as.integer(substr(`TIME OCC`, 3, 4)),
time = sprintf("%02d:%02d", hour, minute)
)
ggplot(crime_df, aes(x = `Vict Age`)) +
geom_histogram(binwidth = 5, fill = "steelblue", color = "white") +
theme_minimal() +
labs(title = "Distribution of Victim Age", x = "Victim Age", y = "Number of Incidents")
crime_df <- crime_df %>%
filter(`Vict Age` >= 0.1 | is.na(`Vict Age`))
ggplot(crime_df, aes(x = `Vict Age`)) +
geom_histogram(binwidth = 5, fill = "steelblue", color = "white") +
theme_minimal() +
labs(title = "Distribution of Victim Age", x = "Victim Age", y = "Number of Incidents")
crime_df <- crime_df %>%
select(-`Crm Cd 2`, -`Crm Cd 3`, -`Crm Cd 4`, -`Cross Street`, -DR_NO, -`Part 1-2`)
crime_df <- crime_df %>%
filter(`Vict Sex` != "H")
crime_df <- crime_df %>%
filter(`Vict Sex` != "X")
weapon_df <- crime_df %>%
filter(!is.na(`Weapon Used Cd`))
non_weapon_df <- crime_df %>%
filter(is.na(`Weapon Used Cd`)) %>%
select(-`Weapon Used Cd`, -`Weapon Desc`)
missing_summary <- sapply(non_weapon_df, function(x) sum(is.na(x)))
missing_summary
non_weapon_df <- non_weapon_df %>% distinct()
missing_summary <- sapply(weapon_df, function(x) sum(is.na(x)))
missing_summary
weapon_df <- weapon_df %>% distinct()
weapon_df <- na.omit(weapon_df)
non_weapon_df <- na.omit(non_weapon_df)
crime_df <- na.omit(crime_df)
cat_cols <- weapon_df %>%
select(where(~ is.character(.) || is.factor(.))) %>%
colnames()
for (col in cat_cols) {
cat("\nTop 10 for:", col, "\n")
weapon_df %>%
count(.data[[col]], sort = TRUE) %>%
head(10) %>%
print()
}
weapon_numeric_cols <- weapon_df %>% select(where(is.numeric))
weapon_summary_stats <- weapon_numeric_cols %>%
summarise(across(everything(), list(
mean = ~mean(., na.rm = TRUE),
median = ~median(., na.rm = TRUE),
mode = ~as.numeric(names(which.max(table(.)))),
sd = ~sd(., na.rm = TRUE),
min = ~min(., na.rm = TRUE),
max = ~max(., na.rm = TRUE),
range = ~diff(range(., na.rm = TRUE)),
q1 = ~quantile(., 0.25, na.rm = TRUE),
q3 = ~quantile(., 0.75, na.rm = TRUE)
)))
weapon_summary_stats
# Step 1: Aggregate monthly counts, excluding 2024
monthly_weapon_trend <- weapon_df %>%
filter(year != 2024) %>%
count(year, month)
# Step 2: Plot line chart with log y-axis
ggplot(monthly_weapon_trend, aes(x = month, y = n, group = year, color = as.factor(year))) +
geom_line(linewidth = 1.2) +
scale_y_log10() +
theme_minimal() +
labs(
title = "Weapon-Related Crimes by Month (Log Scale)",
x = "Month",
y = "Log(Number of Crimes)",
color = "Year"
)
ggplot(weapon_df, aes(x = `Vict Age`)) +
geom_histogram(binwidth = 5, fill = "cornflowerblue", color = "black") +
theme_minimal() +
labs(
title = "Distribution of Victim Age",
x = "Victim Age",
y = "Number of Crimes"
)
ggplot(weapon_df, aes(x = minute)) +
geom_histogram(binwidth = 1, fill = "darkorchid", color = "black") +
