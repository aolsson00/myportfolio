)
# Step 1: Get the top 20 most common Crm Cd
top_20_crime_codes <- weapon_df %>%
count(`Crm Cd`, sort = TRUE) %>%
slice_head(n = 20) %>%
pull(`Crm Cd`)
# Step 2: Filter weapon_df for only those top crime codes
filtered_weapon_df <- weapon_df %>%
filter(`Crm Cd` %in% top_20_crime_codes)
# Step 3: Aggregate frequency by hour and Crm Cd
crm_hourly_freq <- filtered_weapon_df %>%
group_by(hour, `Crm Cd`) %>%
summarise(count = n(), .groups = "drop")
# Step 4: Plot scatter with lines
ggplot(crm_hourly_freq, aes(x = hour, y = count, color = as.factor(`Crm Cd`))) +
geom_point(size = 2, alpha = 0.7) +
geom_line(linewidth = 1, alpha = 0.8) +
theme_minimal() +
labs(
title = "Hourly Frequency of Top 20 Crime Codes (Weapon-Related)",
x = "Hour of Day",
y = "Number of Crimes",
color = "Crime Code"
)
# Step 1: Get top 5 areas by number of observations
top_5_areas <- weapon_df %>%
count(`AREA NAME`, sort = TRUE) %>%
slice_head(n = 5) %>%
pull(`AREA NAME`)
# Step 2: Filter data to only include those top 5 areas
top_area_weapon_df <- weapon_df %>%
filter(`AREA NAME` %in% top_5_areas)
# Step 3: Count crimes per hour per area
area_hour_freq <- top_area_weapon_df %>%
group_by(hour, `AREA NAME`) %>%
summarise(count = n(), .groups = "drop")
# Step 4: Plot
ggplot(area_hour_freq, aes(x = hour, y = count, color = `AREA NAME`)) +
geom_line(linewidth = 1.2) +
geom_point(size = 2, alpha = 0.7) +
theme_minimal() +
labs(
title = "Hourly Trend of Weapon-Related Crimes in Top 5 Areas",
x = "Hour of Day",
y = "Number of Crimes",
color = "Area Name"
)
# Step 1: Filter out Vict Sex == "X"
filtered_weapon_df <- weapon_df %>%
filter(`Vict Sex` != "X")
# Step 2: Get Top 5 most common crime descriptions
top_5_crimes <- filtered_weapon_df %>%
count(`Crm Cd Desc`, sort = TRUE) %>%
slice_head(n = 5) %>%
pull(`Crm Cd Desc`)
# Step 3: Filter to only those crime descriptions
filtered_top_df <- filtered_weapon_df %>%
filter(`Crm Cd Desc` %in% top_5_crimes)
# Step 4: Aggregate by hour, crime description, and Vict Sex
crime_hour_sex_summary <- filtered_top_df %>%
group_by(hour, `Crm Cd Desc`, `Vict Sex`) %>%
summarise(count = n(), .groups = "drop")
# Step 5: Plot
ggplot(crime_hour_sex_summary, aes(x = hour, y = count, color = `Crm Cd Desc`)) +
geom_line(linewidth = 1.2, alpha = 0.8) +
facet_wrap(~ `Vict Sex`) +
theme_minimal() +
labs(
title = "Hourly Trends of Top 5 Crimes by Victim Sex (Excluding 'X')",
x = "Hour of Day",
y = "Number of Incidents",
color = "Crime Description"
)
hourly_tests <- filtered_top_df %>%
filter(`Vict Sex` %in% c("F", "M")) %>%
group_by(hour) %>%
summarise(
female = sum(`Vict Sex` == "F"),
male = sum(`Vict Sex` == "M")
) %>%
rowwise() %>%
mutate(p_test = list(prop.test(c(female, male), c(female + male, female + male)))) %>%
mutate(p_value = p_test$p.value) %>%
select(hour, female, male, p_value)
print(hourly_tests)
weapon_freq <- weapon_df %>% filter(!is.na(`Weapon Desc`)) %>% count(`Weapon Desc`, sort = TRUE)
weapon_crime_code1 <- weapon_df %>% filter(!is.na(`Crm Cd 1`)) %>% count(`Crm Cd 1`, sort = TRUE)
weapon_status_desc <- weapon_df %>% filter(!is.na(`Status Desc`)) %>% count(`Status Desc`, sort = TRUE)
weapon_area_name <- weapon_df %>% filter(!is.na(`AREA NAME`)) %>% count(`AREA NAME`, sort = TRUE)
weapon_sex_count <- weapon_df %>% filter(!is.na(`Vict Sex`)) %>% count(`Vict Sex`, sort = TRUE)
print(weapon_freq)
print(weapon_crime_code1)
print(weapon_status_desc)
print(weapon_area_name)
print(weapon_sex_count)
ggplot(weapon_sex_count, aes(x = `Vict Sex`, y = n)) +
geom_col(fill = "orange") +
theme_minimal() +
labs(
title = "Weapon-Related Crimes by Victim Sex",
x = "Victim Sex",
y = "Count"
)
ggplot(weapon_df, aes(x = hour, y = `Vict Age`)) +
geom_jitter(width = 0.3, height = 0.3, alpha = 0.4, color = "darkgreen") +
theme_minimal() +
labs(
title = "Victim Age by Hour of the Day",
x = "Hour of Day (24-hour format)",
y = "Victim Age"
)
ggplot(weapon_df %>% filter(`Vict Age` <= 18), aes(x = hour, y = `Vict Age`)) +
geom_jitter(width = 0.3, height = 0.3, alpha = 0.5, color = "firebrick") +
theme_minimal() +
labs(
title = "Victim Age (≤ 18) by Hour of the Day",
x = "Hour of Day (24-hour format)",
y = "Victim Age"
)
# Facet grid: Victim Age vs Hour faceted by AREA NAME
ggplot(top_area_weapon_df, aes(x = hour, y = `Vict Age`)) +
geom_point(alpha = 0.3, color = "steelblue") +
facet_wrap(~ `AREA NAME`) +
theme_minimal() +
labs(
title = "Victim Age vs Hour by Top 5 Areas",
x = "Hour of Day",
y = "Victim Age"
)
# Set up knitr and load necessary libraries
knitr::opts_chunk$set(echo = TRUE)
library(reshape2)
library(tidyverse)
library(readr)
library(lubridate)
library(ggplot2)
library(scales)
library(broom)
library(dplyr)
# Load crime dataset from uploaded file
crime_data_path <- "Crime_Data_from_2020_to_Present.csv"
crime_df <- read_csv(crime_data_path)
# Preview structure
str(crime_df)
head(crime_df)
# Check for missing values
missing_summary <- sapply(crime_df, function(x) sum(is.na(x)))
missing_summary
# Remove rows with missing DATE OCC or Crm Cd Desc
crime_df <- crime_df %>%
filter(!is.na(`DATE OCC`), !is.na(`Crm Cd Desc`))
# Check for duplicates
crime_df <- crime_df %>% distinct()
crime_df <- crime_df %>%
mutate(
datetime = mdy_hms(`DATE OCC`, quiet = TRUE),
datetime = if_else(is.na(datetime), mdy_hm(`DATE OCC`, quiet = TRUE), datetime),
year = year(datetime),
month = month(datetime, label = TRUE),
day = day(datetime),
time = format(datetime, "%H:%M:%S")
) %>%
mutate(
`TIME OCC` = str_pad(as.character(`TIME OCC`), width = 4, pad = "0"),
hour = as.integer(substr(`TIME OCC`, 1, 2)),
minute = as.integer(substr(`TIME OCC`, 3, 4)),
time = sprintf("%02d:%02d", hour, minute)
)
